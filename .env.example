# =====================================================================
#  Configuración del daemon
#  Copia este archivo como .env y rellénalo:   cp .env.example .env
#  El archivo .env tiene tus claves: NO lo subas nunca a ningún sitio.
# =====================================================================

# ---------------------------------------------------------------------
#  Telegram (obligatorio)
# ---------------------------------------------------------------------
# api_id y api_hash de tu cuenta: https://my.telegram.org/apps
TELEGRAM_DAEMON_API_ID=
TELEGRAM_DAEMON_API_HASH=

# Token del bot, se crea hablando con @BotFather
TELEGRAM_DAEMON_BOT=

# Tu ID numérico de usuario de Telegram (solo tú podrás manejar el bot).
# Lo puedes ver escribiendo a @userinfobot
TELEGRAM_DAEMON_OWNER_ID=

# ID del canal/grupo donde el daemon escucha y responde (suele empezar por -100)
TELEGRAM_DAEMON_CHANNEL=

# Qué hacer si ya existe un archivo con el mismo nombre: rename | overwrite | ignore
TELEGRAM_DAEMON_DUPLICATES=rename

# ---------------------------------------------------------------------
#  Carpetas en tu máquina (rutas del HOST)
# ---------------------------------------------------------------------
# Carpeta donde se guardan las descargas
DOWNLOADS_DIR=./downloads

# Zona horaria
TZ=Europe/Madrid

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
#  Renombrado con FileBot (opcional)
#  Necesitas FileBot (licencia propia, no se incluye). Pon su carpeta en
#  ./filebot-pro (debe tener bin/filebot-pro). Si no está, no se renombra nada.
# ---------------------------------------------------------------------
FILEBOT_LANG=es
# Subcarpeta (dentro de descargas) donde se queda lo renombrado que no se coloca
FILEBOT_OUTPUT_SUBFOLDER=renombrados

# ---------------------------------------------------------------------
#  Biblioteca de pelis/series (opcional)
#  Lista NOMBRE=/ruta_dentro_del_contenedor separada por comas.
#  Cada ruta tiene que estar montada en el contenedor (mira
#  docker-compose.override.example.yml). Vacío = no se mueve nada a la biblioteca.
#  Dentro de cada disco se usan las carpetas: Peliculas, Peliculas_Infantiles,
#  Peliculas_4k, Peliculas_4k_Infantiles, Series, Series_Infantiles
# ---------------------------------------------------------------------
LIBRARY_DISKS=
# Espacio que se deja libre siempre en cada disco (GB)
LIBRARY_RESERVE_GB=100
# Días que se guarda la papelera de la biblioteca antes de borrarse
LIBRARY_TRASH_DAYS=14
# 1 = solo decide el destino, sin mover nada (para probar)
LIBRARY_DRY_RUN=0
# Ruta de la carpeta de descargas vista desde un montaje que incluya también la
# biblioteca (así mover es instantáneo en vez de copiar). Normalmente vacío.
DOWNLOADS_HOST_PATH=

# ---------------------------------------------------------------------
#  IA para identificar nombres raros (opcional, gratis en https://console.groq.com)
#  Solo sugiere el título; FileBot confirma. Vacío = desactivado.
# ---------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
